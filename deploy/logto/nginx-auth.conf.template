# Host nginx vhost that fronts the self-hosted Logto container.
#
# Render this template by substituting __DOMAIN__ with your auth host
# (e.g. auth.example.com), then drop into /etc/nginx/sites-available/.
# One-liner:
#     sed 's/__DOMAIN__/auth.example.com/g' nginx-auth.conf.template \
#       | sudo tee /etc/nginx/sites-available/auth.example.com >/dev/null
#
# Port routing:
#   443   (user-facing: OIDC, sign-in experience, APIs) -> 127.0.0.1:3011
#   8443  (admin console + admin-tenant OIDC)           -> 127.0.0.1:3012
#
# Both listeners share the single __DOMAIN__ cert. The admin console
# lives on a non-default port (not a subpath) so its SPA's hardcoded
# /api/* fetches resolve to the correct tenant — Logto OSS does not
# support serving the admin SPA from a subpath.
#
# For first-time deploy:
#     sudo certbot --nginx -d __DOMAIN__
# then add the port-8443 server block below + open the firewall:
#     sudo ufw allow 8443/tcp

# ── user-facing (port 443) ────────────────────────────────────────────
server {
    server_name __DOMAIN__;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# ── admin (port 8443) ─────────────────────────────────────────────────
server {
    listen 8443 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3012;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }
}

# ── HTTP -> HTTPS redirect ────────────────────────────────────────────
server {
    if ($host = __DOMAIN__) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name __DOMAIN__;
    return 404;
}
