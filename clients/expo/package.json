{
  "name": "@swapp1990/auth-expo",
  "version": "0.1.0",
  "description": "Shared Logto sign-in for swapp1990 Expo (iOS) apps, with the platform defaults baked in.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" }
  },
  "files": ["src"],
  "scripts": {
    "test": "node --import ./test/support/register.js --test test/*.test.js",
    "check:metro": "node scripts/check-metro.mjs"
  },
  "peerDependencies": {
    "@logto/rn": "^1.2.0",
    "@react-native-async-storage/async-storage": ">=1.23.1 <3",
    "expo-crypto": ">=14.0.2 <57",
    "expo-secure-store": ">=14.0.1 <57",
    "expo-web-browser": ">=14.0.2 <57",
    "react": ">=18"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "license": "MIT"
}
